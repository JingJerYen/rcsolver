# Server port (Render/Fly/Docker set this automatically)
PORT=3000

# Dedicated Anthropic API key for this app. Do NOT reuse ANTHROPIC_API_KEY.
# Leave empty to run in MOCK mode (no API calls, fake recognition results).
RCSOLVER_ANTHROPIC_KEY=

# Force MOCK mode even when a key is present (1 = on)
MOCK_MODE=

# Vision model and effort for colour recognition
RECOGNIZE_MODEL=claude-sonnet-5-5
RECOGNIZE_EFFORT=medium
RECOGNIZE_MAX_TOKENS=16000

# Set to 1 behind a reverse proxy (Render, Fly, nginx) so rate limiting sees the real client IP.
TRUST_PROXY=

# Per-IP calls per minute on /api/recognize, and site-wide calls per UTC day (0 = no daily cap).
RATE_LIMIT_PER_MIN=6
DAILY_LIMIT=100

# Largest accepted face image (decoded bytes). The web page resizes to 512px JPEG, well under this.
MAX_IMAGE_BYTES=400000
